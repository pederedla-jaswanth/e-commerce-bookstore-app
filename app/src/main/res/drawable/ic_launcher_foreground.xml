<!--
  App icon foreground — open-book silhouette in white.
  Artwork fits within the 72×72dp safe zone centred in the 108×108dp canvas.
  The book centre is at (54,54); artwork spans roughly x:[22,86], y:[26,82].
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Left page of the open book.
      Drawn as a rounded quadrilateral leaning slightly left.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
          M54,32
          C54,32 48,30 36,31
          C28,31.5 24,34 23,37
          L22,72
          C22,74 23.5,75 25,74.5
          C36,71 48,72 54,74
          Z" />

    <!--
      Right page of the open book.
      Mirror of the left page.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
          M54,32
          C54,32 60,30 72,31
          C80,31.5 84,34 85,37
          L86,72
          C86,74 84.5,75 83,74.5
          C72,71 60,72 54,74
          Z" />

    <!--
      Spine — thin white rectangle running down the centre crease.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M52.5,32 L55.5,32 L55.5,74 L52.5,74 Z" />

    <!--
      Bottom binding strip — semi-transparent dark strip at the base.
    -->
    <path
        android:fillColor="#00000033"
        android:pathData="M22,70 L86,70 L86,76 Q54,80 22,76 Z" />

</vector>
